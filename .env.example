# =====================================================================
# Plagiarism Pre-Check - Commercial Environment Configuration (.env.example)
# All configuration variables are prefixed with PC_.
# Never commit the active .env file to public version control.
# =====================================================================

# Environment mode: dev | test | prod
PC_ENV=dev

# Public client URL for CORS and Certificate verification QR codes
PC_SITE_URL=http://localhost:3000

# Queue & Background Workers (Local Redis or Upstash in Production)
PC_REDIS_URL=redis://localhost:6379/0

# Database Persistence (Local PostgreSQL or Supabase in Production)
PC_DATABASE_URL=postgresql://plagiarism:plagiarism@localhost:5432/plagiarism

# JWT Authentication & Secret Keys
PC_JWT_SECRET_KEY=change-this-in-production-to-a-secure-random-secret-key-32chars
PC_JWT_ALGORITHM=HS256
PC_JWT_EXPIRE_MINUTES=1440

# Error Tracking & APM (Optional, leave blank to disable)
# Sentry integration automatically scrubs all raw document text, payloads, and passwords.
PC_SENTRY_DSN=

# Upload Limits & Safeguards (Section 4)
PC_MAX_FILE_MB=7  # Maximum file size in MB (low values may reject test files and resemble scan failures)
PC_MIN_WORDS=100
PC_MAX_WORDS=30000
PC_MAX_PASTE_WORDS=2000
PC_MAX_PDF_PAGES=200
PC_MAX_OCR_PAGES=40
PC_MAX_DOCX_UNCOMPRESSED_MB=50

# Rate Limiting & Concurrency Defense
PC_DAILY_CHECKS_PER_USER=5  # Daily scan quota per user (low values can be exhausted quickly during testing and look like scan failures)
PC_CONCURRENT_JOBS_PER_USER=1
PC_QUEUE_CAP=20
PC_JOB_TIMEOUT_S=180

# Privacy Retention & Data Minimization (Section 9)
PC_JOB_TEXT_MAX_AGE_MINUTES=60
PC_REPORT_RETENTION_DAYS=30
PC_UPLOAD_LEFTOVER_MAX_AGE_HOURS=24

# Queue Names
PC_FAST_QUEUE=fast
PC_OCR_QUEUE=ocr
PC_OCR_CONCURRENCY=1
